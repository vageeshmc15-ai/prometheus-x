# GEMINI_API_KEY: Required for server-side Gemini AI explanations, reports, and dashboard assistant.
# Configure this in your deployment secret manager or local .env (never commit real keys).
GEMINI_API_KEY=""

# APP_URL: Public URL where this application is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL (Cloud SQL) Runtime Credentials
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# Alternative: Single PostgreSQL connection URL (used automatically on Render, Railway, Neon, Supabase when SQL_HOST is unset)
DATABASE_URL=""

# PostgreSQL Admin Credentials (used exclusively by Drizzle Kit schema push)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional: Initial Super Admin email override for first-run bootstrap
SUPER_ADMIN_EMAIL=""

# Optional: Firebase Project ID if verifying external Firebase ID tokens server-side
FIREBASE_PROJECT_ID=""

# Optional: Client-side Firebase Web Config (set real values only in local .env.local or hosting env settings)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional: External backend API URL if hosting the frontend separately on a static host (e.g. https://your-api.run.app/api)
VITE_API_BASE_URL=""

